            -- =============================================
            -- Aimbot
            -- =============================================

            local RefreshAimbotEnabledToggleKeypickerState = nil
            local AimbotBridge = {}
            do
            do
                local function IsTouchAimbotDevice()
                    return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
                end

                local function GetAimbotViewportCenter()
                    local camera = Workspace.CurrentCamera
                    if camera then
                        return Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)
                    end

                    return Vector2.zero
                end

                AimbotBridge.GetAimbotPointerPosition = function()
                    if IsTouchAimbotDevice() or IsAimbotGameReady() then
                        return GetAimbotViewportCenter()
                    end

                    return UserInputService:GetMouseLocation()
                end

                AimbotBridge.ResolveAimbotEquippedItem = function()
                    -- Diagnostic: bypassing FighterDataCache.LocalLoadout cache (b6ffd73)
                    -- to test whether stale-cache reads are causing visible-player misses.
                    -- Revert this hunk if the cache turns out not to be the culprit.
                    local fighter = ResolveLocalFighter()
                    return fighter and fighter.EquippedItem or nil
                end

                local AIMBOT_HARD_BLOCK_ITEMS = {
                    ['Warper'] = true,
                    ['Medkit'] = true,
                    ['Subspace Tripmine'] = true,
                    ['Warpstone'] = true,
                    ['Flashbang'] = true,
                    ['Grenade'] = true,
                    ['Jump Pad'] = true,
                    ['Molotov'] = true,
                    ['Satchel'] = true,
                    ['Smoke Grenade'] = true,
                    ['War Horn'] = true,
                    ['Grappler'] = true,
                    ['Flamethrower'] = true,
                }

                local AIMBOT_HOLD_FIRE_ITEMS = {
                    ['Flamethrower'] = true,
                }

                AimbotBridge.CanUseAimbotWithItem = function(item)
                    if not item then
                        return false
                    end

                    -- Layer 1: hard-block (unchanged behavior)
                    if AIMBOT_HARD_BLOCK_ITEMS[item.Name] == true then
                        return false
                    end

                    -- Layer 2: user "Ignore Aimbot Weapons" dropdown (unchanged behavior)
                    local selection = Options.P2S1D4 and Options.P2S1D4.Value
                    if type(selection) == 'table' then
                        if selection[item.Name] == true then
                            return false
                        end
                        for _, selectedName in ipairs(selection) do
                            if selectedName == item.Name then
                                return false
                            end
                        end
                    end

                    -- Layer 3: 3-lane auto-recognition. Default-deny outside lanes.
                    -- Lane A: shoot/melee cooldown signals — inlined SHAPE CHECK from
                    -- IsAimbotSilentShotHookItem body (line ~3140). Cannot call that
                    -- function directly: it calls CanUseTriggerbotWithItem which calls
                    -- CanUseAimbotWithItem -> stack overflow. Shape check is safe.
                    local info = item.Info
                    if info and type(item.StartShooting) == 'function' then
                        local hasTimedShotCooldown = type(info.ShootCooldown) == 'number'
                            or type(info.ShootBurstCooldown) == 'number'
                            or type(info.ShootBurst) == 'number'
                            or type(info.QuickShotCooldown) == 'number'
                            or type(info.ChargeReleaseCooldown) == 'number'
                            or type(info.BladeCooldown) == 'number'
                        local hasMeleeAttackCooldown = type(info.AttackCooldown) == 'number'
                            and ((info.Class == 'Melee') or (info.Type == 'Melee'))
                        if hasTimedShotCooldown or hasMeleeAttackCooldown then
                            return true
                        end
                    end
                    -- Lane B: projectile weapons that support trigger-fire.
                    local name = item.Name
                    if name == 'Daggers' or name == 'Bow' or name == 'Slingshot' then
                        return true
                    end
                    -- Lane C: explicit hold-fire items
                    if AIMBOT_HOLD_FIRE_ITEMS[name] == true then
                        return true
                    end

                    return false
                end

                AimbotBridge.CanUseTriggerbotWithItem = function(item)
                    return AimbotBridge.CanUseAimbotWithItem(item)
                end

                AimbotBridge.SyncAimbotToggleKeypickerToUi = function(toggle, keypicker)
                    if not toggle or not keypicker then
                        return function() end
                    end

                    local applyingToggleState = false
                    local applyingKeypickerState = false
                    local lastMode = keypicker.Mode

                    local function syncKeypickerFromToggle(value)
                        if keypicker.Mode ~= 'Toggle' then
                            lastMode = keypicker.Mode
                            return
                        end

                        local nextState = value == true
                        if keypicker.Toggled == nextState then
                            lastMode = keypicker.Mode
                            return
                        end

                        applyingToggleState = true
                        keypicker.Toggled = nextState
                        if type(keypicker.Update) == 'function' then
                            keypicker:Update()
                        end
                        applyingToggleState = false
                        lastMode = keypicker.Mode
                    end

                    if type(toggle.OnChanged) == 'function' then
                        toggle:OnChanged(function(value)
                            if applyingKeypickerState then
                                return
                            end

                            syncKeypickerFromToggle(value)
                        end)
                    end

                    if type(keypicker.OnClick) == 'function' then
                        keypicker:OnClick(function(state)
                            if applyingToggleState or keypicker.Mode ~= 'Toggle' then
                                lastMode = keypicker.Mode
                                return
                            end

                            local nextValue = state == true
                            if toggle.Value == nextValue then
                                lastMode = keypicker.Mode
                                return
                            end

                            applyingKeypickerState = true
                            toggle:SetValue(nextValue)
                            applyingKeypickerState = false
                            lastMode = keypicker.Mode
                        end)
                    end

                    syncKeypickerFromToggle(toggle.Value)

                    return function()
                        if keypicker.Mode == 'Toggle' and lastMode ~= 'Toggle' then
                            syncKeypickerFromToggle(toggle.Value)
                        else
                            lastMode = keypicker.Mode
                        end
                    end
                end

                -- The Kicia ragebot (P8S4T1) is a self-contained teleport-to-void ragebot that

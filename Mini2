                        Distance = distance,
                    }

                    return ESP[player]
                end

                --==============================================================
                -- REMOVE
                --==============================================================

                local function RemoveESP(player)

                    local object =
                        ESP[player]

                    if not object then
                        return
                    end

                    if object.Holder then
                        object.Holder:Destroy()
                    end

                    ESP[player] = nil
                end

                --==============================================================
                -- CHARACTER
                --==============================================================

                local function GetCharacter(player)

                    local character =
                        player.Character

                    if not character then
                        return
                    end

                    local humanoid =
                        character:FindFirstChildOfClass(
                            "Humanoid"
                        )

                    local root =
                        character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if not humanoid or not root then
                        return
                    end

                    if humanoid.Health <= 0 then
                        return
                    end

                    return character,
                        humanoid,
                        root
                end

                --==============================================================
                -- STABLE BOX
                --==============================================================

                local function GetStableBox(
                    camera,
                    character,
                    root
                )

                    local success,
                        boxCFrame,
                        boxSize =
                        pcall(function()
                            return character:GetBoundingBox()
                        end)

                    if not success
                        or not boxCFrame
                        or not boxSize then

                        return
                    end

                    local topWorld =
                        Vector3.new(
                            boxCFrame.Position.X,
                            boxCFrame.Position.Y +
                                boxSize.Y / 2,
                            boxCFrame.Position.Z
                        )

                    local bottomWorld =
                        Vector3.new(
                            boxCFrame.Position.X,
                            boxCFrame.Position.Y -
                                boxSize.Y / 2,
                            boxCFrame.Position.Z
                        )

                    local topScreen =
                        camera:WorldToViewportPoint(
                            topWorld
                        )

                    local bottomScreen =
                        camera:WorldToViewportPoint(
                            bottomWorld
                        )

                    local rootScreen =
                        camera:WorldToViewportPoint(
                            root.Position
                        )

                    if topScreen.Z <= 0
                        or bottomScreen.Z <= 0
                        or rootScreen.Z <= 0 then

                        return
                    end

                    local rawHeight =
                        math.abs(
                            bottomScreen.Y -
                            topScreen.Y
                        )

                    if rawHeight <= 0
                        or rawHeight > 1800 then

                        return
                    end

                    local height =
                        rawHeight +
                        Config.TopPadding +
                        Config.BottomPadding

                    local width =
                        height *
                        Config.WidthScale

                    return
                        rootScreen.X,
                        (
                            topScreen.Y +
                            bottomScreen.Y
                        ) / 2,
                        width,
                        height
                end

                --==============================================================
                -- ESP SIZE
                --==============================================================

                local function GetESPSize(
                    realWidth,
                    realHeight,
                    distance
                )

                    local alpha =
                        math.clamp(
                            (
                                distance -
                                Config.FarDistanceStart
                            ) /
                            (
                                Config.VeryFarDistance -
                                Config.FarDistanceStart
                            ),
                            0,
                            1
                        )

                    -- ESP全体を少し大きくする
                    local width =
                        realWidth *
                        Config.SizeBoost

                    local height =
                        realHeight *
                        Config.SizeBoost

                    --==========================================================
                    -- MIN SIZE
                    --==========================================================

                    local minHeight =
                        (
                            Config.MinHeightNear +
                            (
                                Config.MinHeightFar -
                                Config.MinHeightNear
                            ) * alpha
                        ) *
                        Config.SizeBoost

                    local minWidth =
                        (
                            Config.MinWidthNear +
                            (
                                Config.MinWidthFar -
                                Config.MinWidthNear
                            ) * alpha
                        ) *
                        Config.SizeBoost

                    width =
                        math.max(
                            width,
                            minWidth
                        )

                    height =
                        math.max(
                            height,
                            minHeight
                        )

                    --==========================================================
                    -- MAX SIZE
                    --==========================================================

                    width =
                        math.min(
                            width,
                            Config.MaxWidth
                        )

                    height =
                        math.min(
                            height,
                            Config.MaxHeight
                        )

                    return width, height, alpha
                end

                --==============================================================
                -- BRACKET DRAW
                --==============================================================

                local function UpdateBrackets(
                    object,
                    width,
                    height
                )

                    local white =
                        math.max(
                            1,
                            Config.BracketThickness
                        )

                    local black =
                        math.max(
                            0,
                            Config.BracketOutlineThickness
                        )

                    -- 白線の外側だけに黒アウトライン
                    local outerThickness =
                        white + black * 2

                    --==========================================================
                    -- LENGTH
                    --==========================================================

                    local length =
                        math.min(
                            width,
                            height
                        ) * 0.22

                    length =
                        math.clamp(
                            length,
                            Config.BracketLengthMin,
                            Config.BracketLengthMax
                        )

                    -- 外側にはみ出さないように制限
                    local maxLengthX =
                        math.max(
                            1,
                            width - outerThickness
                        )

                    local maxLengthY =
                        math.max(
                            1,
                            height - outerThickness
                        )

                    length =
                        math.min(
                            length,
                            maxLengthX,
                            maxLengthY
                        )

                    local outerLength =
                        length + black * 2

                    --==========================================================
                    -- TOP LEFT
                    --==========================================================

                    object.O_TL_H.Position =
                        UDim2.fromOffset(
                            0,
                            0
                        )

                    object.O_TL_H.Size =
                        UDim2.fromOffset(
                            outerLength,
                            outerThickness
                        )

                    object.O_TL_V.Position =
                        UDim2.fromOffset(
                            0,
                            0
                        )

                    object.O_TL_V.Size =
                        UDim2.fromOffset(
                            outerThickness,
                            outerLength
                        )

                    object.W_TL_H.Position =
                        UDim2.fromOffset(
                            black,
                            black
                        )

                    object.W_TL_H.Size =
                        UDim2.fromOffset(
                            length,
                            white
                        )

                    object.W_TL_V.Position =
                        UDim2.fromOffset(
                            black,
                            black
                        )

                    object.W_TL_V.Size =
                        UDim2.fromOffset(
                            white,
                            length
                        )

                    --==========================================================
                    -- TOP RIGHT
                    --==========================================================

                    object.O_TR_H.Position =
                        UDim2.fromOffset(
                            width - outerLength,
                            0
                        )

                    object.O_TR_H.Size =
                        UDim2.fromOffset(
                            outerLength,
                            outerThickness
                        )

                    object.O_TR_V.Position =
                        UDim2.fromOffset(
                            width - outerThickness,
                            0
                        )

                    object.O_TR_V.Size =
                        UDim2.fromOffset(
                            outerThickness,
                            outerLength
                        )

                    object.W_TR_H.Position =
                        UDim2.fromOffset(
                            width - length - black,
                            black
                        )

                    object.W_TR_H.Size =
                        UDim2.fromOffset(
                            length,
                            white
                        )

                    object.W_TR_V.Position =
                        UDim2.fromOffset(
                            width - white - black,
                            black
                        )

                    object.W_TR_V.Size =
                        UDim2.fromOffset(
                            white,
                            length
                        )

                    --==========================================================
                    -- BOTTOM LEFT
                    --==========================================================

                    object.O_BL_H.Position =
                        UDim2.fromOffset(
                            0,
                            height - outerThickness
                        )

                    object.O_BL_H.Size =
                        UDim2.fromOffset(
                            outerLength,
                            outerThickness
                        )

                    object.O_BL_V.Position =
                        UDim2.fromOffset(
                            0,
                            height - outerLength
                        )

                    object.O_BL_V.Size =
                        UDim2.fromOffset(
                            outerThickness,
                            outerLength
                        )

                    object.W_BL_H.Position =
                        UDim2.fromOffset(
                            black,
                            height - white - black
                        )

                    object.W_BL_H.Size =
                        UDim2.fromOffset(
                            length,
                            white
                        )

                    object.W_BL_V.Position =
                        UDim2.fromOffset(
                            black,
                            height - length - black
                        )

                    object.W_BL_V.Size =
                        UDim2.fromOffset(
                            white,
                            length
                        )

                    --==========================================================
                    -- BOTTOM RIGHT
                    --==========================================================

                    object.O_BR_H.Position =
                        UDim2.fromOffset(
                            width - outerLength,
                            height - outerThickness
                        )

                    object.O_BR_H.Size =
                        UDim2.fromOffset(
                            outerLength,
                            outerThickness
                        )

                    object.O_BR_V.Position =
                        UDim2.fromOffset(
                            width - outerThickness,
                            height - outerLength
                        )

                    object.O_BR_V.Size =
                        UDim2.fromOffset(
                            outerThickness,
                            outerLength
                        )

                    object.W_BR_H.Position =
                        UDim2.fromOffset(
                            width - length - black,
                            height - white - black
                        )

                    object.W_BR_H.Size =
                        UDim2.fromOffset(
                            length,
                            white
                        )

                    object.W_BR_V.Position =
                        UDim2.fromOffset(
                            width - white - black,
                            height - length - black
                        )

                    object.W_BR_V.Size =
                        UDim2.fromOffset(
                            white,
                            length
                        )
                end

                --==============================================================
                -- UPDATE ESP
                --==============================================================

                local function UpdateESP(
                    player,
                    object,
                    camera
                )

                    if not RivalsRuntimeBridge.MiniHubSupport.Visual.CornerEnabled then
                        object.Holder.Visible = false
                        return
                    end

                    local character,
                        humanoid,
                        root =
                        GetCharacter(player)

                    if not character then
                        object.Holder.Visible = false
                        return
                    end

                    local localCharacter =
                        LocalPlayer.Character

                    if not localCharacter then
                        object.Holder.Visible = false
                        return
                    end

                    local localRoot =
                        localCharacter:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if not localRoot then
                        object.Holder.Visible = false
                        return
                    end

                    --==========================================================
                    -- DISTANCE
                    --==========================================================

                    local distance =
                        (
                            localRoot.Position -
                            root.Position
                        ).Magnitude

                    if distance > Config.MaxDistance then
                        object.Holder.Visible = false
                        return
                    end

                    --==========================================================
                    -- BOX
                    --==========================================================

                    local centerX,
                        centerY,
                        realWidth,
                        realHeight =
                        GetStableBox(
                            camera,
                            character,
                            root
                        )

                    if not centerX then
                        object.Holder.Visible = false
                        return
                    end

                    local width,
                        height,
                        alpha =
                        GetESPSize(
                            realWidth,
                            realHeight,
                            distance
                        )

                    local x =
                        centerX -
                        width / 2

                    local y =
                        centerY -
                        height / 2

                    --==========================================================
                    -- VIEWPORT
                    --==========================================================

                    local viewport =
                        camera.ViewportSize

                    if x > viewport.X
                        or x + width < 0
                        or y > viewport.Y
                        or y + height < 0 then

                        object.Holder.Visible = false
                        return
                    end

                    --==========================================================
                    -- HOLDER
                    --==========================================================

                    object.Holder.Position =
                        UDim2.fromOffset(
                            math.floor(x),
                            math.floor(y)
                        )

                    object.Holder.Size =
                        UDim2.fromOffset(
                            math.max(
                                1,
                                math.floor(width)
                            ),
                            math.max(
                                1,
                                math.floor(height)
                            )
                        )

                    object.Holder.Visible = true

                    --==========================================================
                    -- BOX
                    --==========================================================

                    object.Box.Visible =
                        Config.BoxESP

                    if Config.BoxESP then

                        UpdateBrackets(
                            object,
                            width,
                            height
                        )
                    end

                    --==========================================================
                    -- HEALTH
                    --==========================================================

                    object.HealthOutline.Visible =
                        RivalsRuntimeBridge.MiniHubSupport.Visual.ESPHealth

                    if RivalsRuntimeBridge.MiniHubSupport.Visual.ESPHealth then

                        local healthWidth =
                            Config.HealthWidthNear +
                            (
                                Config.HealthWidthFar -
                                Config.HealthWidthNear
                            ) * alpha

                        healthWidth =
                            math.clamp(
                                math.floor(
                                    healthWidth + 0.5
                                ),
                                Config.HealthWidthFar,
                                Config.HealthWidthNear
                            )

                        local gap =
                            Config.HealthGapNear +
                            (
                                Config.HealthGapFar -
                                Config.HealthGapNear
                            ) * alpha

                        gap =
                            math.max(
                                Config.HealthGapFar,
                                math.floor(gap + 0.5)
                            )

                        local totalWidth =
                            healthWidth +
                            Config.HealthOutline * 2

                        object.HealthOutline.Size =
                            UDim2.fromOffset(
                                totalWidth,
                                math.max(
                                    1,
                                    math.floor(height)
                                )
                            )

                        object.HealthOutline.Position =
                            UDim2.new(
                                0,
                                -(
                                    totalWidth +
                                    gap
                                ),
                                0,
                                0
                            )

                        object.HealthBack.Position =
                            UDim2.fromOffset(
                                Config.HealthOutline,
                                Config.HealthOutline
                            )

                        object.HealthBack.Size =
                            UDim2.new(
                                1,
                                -Config.HealthOutline * 2,
                                1,
                                -Config.HealthOutline * 2
                            )

                        local maxHealth =
                            math.max(
                                humanoid.MaxHealth,
                                1
                            )

                        local ratio =
                            math.clamp(
                                humanoid.Health /
                                    maxHealth,
                                0,
                                1
                            )

                        object.Health.Size =
                            UDim2.new(
                                1,
                                0,
                                ratio,
                                0
                            )

                        object.Health.BackgroundColor3 =
                            Config.HealthLowColor:Lerp(
                                Config.HealthFullColor,
                                ratio
                            )
                    end

                    --==========================================================
                    -- NAME
                    --==========================================================

                    object.Name.Visible =
                        RivalsRuntimeBridge.MiniHubSupport.Visual.ESPName

                    object.Name.Text =
                        player.DisplayName

                    object.Name.TextSize =
                        math.floor(
                            Config.NameSizeNear +
                            (
                                Config.NameSizeFar -
                                Config.NameSizeNear
                            ) * alpha
                        )

                    object.Name.Size =
                        UDim2.fromOffset(
                            math.max(
                                50,
                                math.floor(width * 2)
                            ),
                            18
                        )

                    --==========================================================
                    -- DISTANCE
                    --==========================================================

                    object.Distance.Visible =
                        RivalsRuntimeBridge.MiniHubSupport.Visual.ESPDistance

                    object.Distance.Text =
                        math.floor(distance) ..
                        "m"

                    object.Distance.TextSize =
                        math.floor(
                            Config.DistanceSizeNear +
                            (
                                Config.DistanceSizeFar -
                                Config.DistanceSizeNear
                            ) * alpha
                        )

                    object.Distance.Size =
                        UDim2.fromOffset(
                            math.max(
                                45,
                                math.floor(width * 1.5)
                            ),
                            16
                        )
                end

                --==============================================================
                -- INITIAL PLAYERS
                --==============================================================

                for _, player in ipairs(
                    Players:GetPlayers()
                ) do

                    if player ~= LocalPlayer then
                        CreateESP(player)
                    end
                end

                --==============================================================
                -- PLAYER ADDED
                --==============================================================

                RivalsRuntimeBridge.MiniHubSupport.Connect(Players.PlayerAdded, 
                    function(player)

                        if player ~= LocalPlayer then
                            CreateESP(player)
                        end
                    end
                )

                --==============================================================
                -- PLAYER REMOVING
                --==============================================================

                RivalsRuntimeBridge.MiniHubSupport.Connect(Players.PlayerRemoving, 
                    function(player)

                        RemoveESP(player)
                    end
                )

                --==============================================================
                -- RENDER LOOP
                --==============================================================

                RivalsRuntimeBridge.MiniHubSupport.Connect(RunService.RenderStepped, 
                    function()

                        local camera =
                            workspace.CurrentCamera

                        if not camera then
                            return
                        end

                        for player, object in pairs(ESP) do

                            if player.Parent ~= Players then

                                RemoveESP(player)

                            else

                                UpdateESP(
                                    player,
                                    object,
                                    camera
                                )
                            end
                        end
                    end
                )
            end


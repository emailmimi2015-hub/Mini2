            local function B64Decode(Data)
                local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
                local Lookup = {}
                for i = 1, #Alphabet do Lookup[Alphabet:byte(i)] = i - 1 end
                local Out, Buf, Bits = {}, 0, 0
                for i = 1, #Data do
                    local V = Lookup[Data:byte(i)]
                    if V then
                        Buf = Buf * 64 + V
                        Bits = Bits + 6
                        if Bits >= 8 then
                            Bits = Bits - 8
                            local Byte = math.floor(Buf / 2 ^ Bits)
                            Buf = Buf - Byte * 2 ^ Bits
                            Out[#Out + 1] = string.char(Byte)
                        end
                    end
                end
                return table.concat(Out)
            end
            pcall(function()
                if not (writefile and getcustomasset) then return end
                local FileName = "kicia_minions2.png"
                writefile(FileName, B64Decode(table.concat(MinionChunks)))
                local MinionImage = Instance.new("ImageLabel")
                MinionImage.Name = "MinionDecoration"

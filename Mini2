                    if not AimbotBridge.CanUseAimbotWithItem(AimbotBridge.ResolveAimbotEquippedItem()) then
                        return false
                    end

                    if not (Toggles.P2S1T1 and Toggles.P2S1T1.Value) then
                        return false
                    end

                    if Options.P2S1T1K and type(Options.P2S1T1K.GetState) == 'function' then
                        return Options.P2S1T1K:GetState()
                    end

                    return true
                end

                AimbotBridge.IsAimbotEnabled = function()
                    if AimbotBridge.IsRagebotForcingCombat() then
                        return AimbotBridge.CanUseAimbotWithItem(AimbotBridge.ResolveAimbotEquippedItem())
                    end
                    return AimbotBridge.ResolveAimbotMode() == 'Silent'
                        and AimbotBridge.IsExplicitAimbotEnabled()
                end

                AimbotBridge.IsCameraAimEnabled = function()
                    if AimbotBridge.ResolveAimbotMode() ~= 'Camera'
                        or not AimbotBridge.IsExplicitAimbotEnabled() then
                        return false
                    end
                    if AimbotInputState.SyntheticInputBlocked() then
                        return false
                    end
                    if not IsTouchAimbotDevice()
                        and not AimbotInputState.RightMouse then
                        return false
                    end
                    return true
                end

                AimbotBridge.IsTriggerbotEnabled = function()
                    if not AimbotBridge.CanUseTriggerbotWithItem(AimbotBridge.ResolveAimbotEquippedItem()) then
                        return false
                    end

                    if AimbotBridge.IsRagebotForcingCombat() then
                        return true
                    end

                    if not (Toggles.P2S1T7 and Toggles.P2S1T7.Value) then
                        return false
                    end

                    if Options.P2S1T7K and type(Options.P2S1T7K.GetState) == 'function' then
                        return Options.P2S1T7K:GetState()
                    end

                    return true
                end

                AimbotBridge.IsAimbotIgnoreFovEnabled = function()
                    return Toggles.P2S1T3 and Toggles.P2S1T3.Value == true
                end

                AimbotBridge.UpdateAimbotFovCircle = function(active, gameReady, usesFov)
                    local showFov = Toggles.P2S1T5 and Toggles.P2S1T5.Value
                    if not active or not gameReady or not usesFov or not showFov then
